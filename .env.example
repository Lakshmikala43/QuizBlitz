# Flask Core Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=quiz-royale-dev-secret-key-change-in-production-random-token-998877

# Database Configuration
DATABASE_URL=sqlite:///instance/quiz_royale.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://quiz_user:quiz_pass@localhost:5432/quiz_royale

# Session & Security
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400

# Game Engine Tuning
DEFAULT_QUESTION_TIME_LIMIT=15
STREAK_BONUS_MULTIPLIER=1.1
MAX_STREAK_CAP=5
DAILY_CHALLENGE_QUESTIONS=10

# Server SocketIO
SOCKETIO_ASYNC_MODE=threading
